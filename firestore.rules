rules_version = '2';

// Scrubber Duckies: one shared house, open only to the two of you.
// Paste into Firebase console → Firestore Database → Rules, put your two email
// addresses in place of WILL_EMAIL and TESSA_EMAIL (all lower case), then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['WILL_EMAIL', 'TESSA_EMAIL'];
    }

    match /homes/{home} {
      allow read, write: if allowed();
    }
  }
}
